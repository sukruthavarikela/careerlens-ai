OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: comma-separated browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

